# SessionGuard — .env.example
# Copy to .env (git-ignored) and fill in. No real secrets in this file.
# See DECISIONS.md D-1 / D-4 for the auth and tool-discovery model.

# ─────────────────────────────────────────────────────────────────────────────
# Upstream: Binance Agent OS MCP endpoint
# ─────────────────────────────────────────────────────────────────────────────
# Live endpoint (verified, PRD §0.1). Must be https:// in non-test mode.
BINANCE_AGENT_OS_MCP_URL=https://agent.binance.com/mcp/agentic

# For the required build path (DECISIONS.md D-0) point this at MockUpstream instead:
# BINANCE_AGENT_OS_MCP_URL=http://127.0.0.1:8790
MOCK_UPSTREAM_PORT=8790

# Bearer token obtained by the MCP client OAuth flow (PRD §0.2, D-4).
# SessionGuard consumes this token; it does NOT run an authorization server.
# Acquire via `mcp-remote` / `claude mcp add` against the URL above, then paste here.
BINANCE_AGENT_OS_BEARER_TOKEN=

# Optional: refresh token, if the MCP client advertises a refresh grant (D-4).
# If absent, any upstream 401/403 => fail closed (DATA_UNAVAILABLE) + operator re-auth.
BINANCE_AGENT_OS_REFRESH_TOKEN=

# OAuth client id used during the bootstrap flow (e.g. "codex" for Codex CLI).
BINANCE_AGENT_OS_OAUTH_CLIENT_ID=sessionguard

# Scopes requested at consent (PRD §0.3, D-2, D-6): market data + account + spot trade ONLY.
# NEVER "transfer". There is no withdrawal scope to request.
BINANCE_AGENT_OS_SCOPES=market-data,account,trade:spot

# Hard timeout for the boot-time tools/list capability resolution (DECISIONS.md D-1).
# On timeout OR any unresolved required capability: print one error, exit non-zero. No retry loop.
TOOLS_LIST_TIMEOUT_MS=5000

# ─────────────────────────────────────────────────────────────────────────────
# SessionGuard inbound MCP server (the surface System 1 connects to)
# Localhost only, no auth — acceptable for this local demo ONLY (SECURITY.md §4, D-4).
# ─────────────────────────────────────────────────────────────────────────────
SESSIONGUARD_INBOUND_HOST=127.0.0.1
SESSIONGUARD_INBOUND_PORT=8788
SESSIONGUARD_INBOUND_URL=http://127.0.0.1:8788

# ─────────────────────────────────────────────────────────────────────────────
# Admin surface: manual re-arm + live config swap (PRD Step 10)
# Separate localhost port, requires the token below on every request.
# ─────────────────────────────────────────────────────────────────────────────
SESSIONGUARD_ADMIN_HOST=127.0.0.1
SESSIONGUARD_ADMIN_PORT=8789
SESSIONGUARD_ADMIN_TOKEN=change-me-local-only

# ─────────────────────────────────────────────────────────────────────────────
# Config file location (schema-validated at boot, PRD Step 8). Thresholds live in
# this JSON file; the SG_* vars below are an OPTIONAL override for quick demo tweaks.
# config.json is the source of truth and its configVersion is recorded in every audit row.
# ─────────────────────────────────────────────────────────────────────────────
SESSIONGUARD_CONFIG_PATH=./config.json

# Optional overrides (leave blank to use config.json). Decimal fields are strings.
SG_DRAWDOWN_PCT_LIMIT=5           # halt when cumulative session drawdown <= -5%
SG_VELOCITY_WINDOW_SECONDS=900    # rolling window for the trade-count limit (15 min)
SG_VELOCITY_MAX_TRADES=5          # block the trade that would make it the 6th in the window
SG_LADDER_MULTIPLE_LIMIT=1.5      # block a same-direction size-up > 1.5x after a loss on that symbol
SG_ALLOWED_SYMBOLS=BTCUSDT,ETHUSDT,BNBUSDT
SG_PRICE_STALENESS_SECONDS=10     # a market price older than this => DATA_UNAVAILABLE
SG_DATA_FETCH_TIMEOUT_MS=3000     # per market/account read; on timeout => DATA_UNAVAILABLE
SG_PRICE_SANITY_MAX_DEVIATION_PCT=20  # mark vs recent klines close; beyond this => DATA_UNAVAILABLE

# ─────────────────────────────────────────────────────────────────────────────
# Evidence / audit output
# ─────────────────────────────────────────────────────────────────────────────
SESSIONGUARD_EVIDENCE_DIR=./evidence

# ─────────────────────────────────────────────────────────────────────────────
# Runtime mode: production | demo | test
#   test  => allows an http://127.0.0.1 upstream (MockUpstream); tightens nothing else
#   demo  => MockUpstream expected; live endpoint attempt is post-submit only (D-0)
# ─────────────────────────────────────────────────────────────────────────────
NODE_ENV=demo
